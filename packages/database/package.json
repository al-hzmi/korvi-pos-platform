{
  "name": "@korvi/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./customers": {
      "types": "./dist/src/administration/customers.d.ts",
      "default": "./dist/src/administration/customers.js"
    },
    "./reports": {
      "types": "./dist/src/reports/period-summary.d.ts",
      "default": "./dist/src/reports/period-summary.js"
    },
    "./zatca-merchant": {
      "types": "./dist/src/zatca/merchant-status.d.ts",
      "default": "./dist/src/zatca/merchant-status.js"
    },
    "./zatca-csid-binding": {
      "types": "./dist/src/zatca/csid-binding-repository.d.ts",
      "default": "./dist/src/zatca/csid-binding-repository.js"
    },
    "./zatca-fiscalization": {
      "types": "./dist/src/zatca/fiscalization-repository.d.ts",
      "default": "./dist/src/zatca/fiscalization-repository.js"
    },
    "./platform-operational-bootstrap": {
      "types": "./dist/src/control-plane/operational-bootstrap.d.ts",
      "default": "./dist/src/control-plane/operational-bootstrap.js"
    },
    "./device-enrollment": {
      "types": "./dist/src/control-plane/device-enrollment.d.ts",
      "default": "./dist/src/control-plane/device-enrollment.js"
    },
    "./native-auth": {
      "types": "./dist/src/native-auth/device-session.d.ts",
      "default": "./dist/src/native-auth/device-session.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@korvi/domain": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
