{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Korvi Cashier",
  "version": "0.1.0",
  "identifier": "sa.korvi.cashier",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Korvi Cashier",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../../pos-web/public/app-icon-512.png"],
    "category": "Business",
    "shortDescription": "Korvi cashier runtime",
    "longDescription": "Official cashier-only installed runtime for Korvi POS. Merchant Control and Platform Admin are web-only products."
  }
}
